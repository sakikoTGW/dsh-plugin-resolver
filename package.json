{
  "name": "dsh-plugin-resolver",
  "version": "0.1.3",
  "description": "Agent-facing DSH plugin resolver: search the catalog, pick a version the running DSH accepts, install (registry or GitHub-source build), and verify - no trial and error.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host",
    "logic",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "BENCHMARK.md",
    "ABLATION.md"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/harness.mjs",
    "bench": "node test/benchmark.mjs",
    "ablate": "node test/ablation.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "plugin-installer",
    "resolver",
    "catalog"
  ],
  "author": "sakikoTGW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakikoTGW/dsh-plugin-resolver.git"
  },
  "homepage": "https://github.com/sakikoTGW/dsh-plugin-resolver#readme",
  "bugs": {
    "url": "https://github.com/sakikoTGW/dsh-plugin-resolver/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
